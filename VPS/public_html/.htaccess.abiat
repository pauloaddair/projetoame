<IfModule mod_rewrite.c>
	RewriteEngine on
	RewriteCond %{HTTP_HOST} ^(www.)?abiat.org.br$
	RewriteCond %{REQUEST_URI} !^/home/
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.*)$ /home/$1
	RewriteCond %{HTTP_HOST} ^(www.)?abiat.org.br$
	RewriteRule ^(/)?$ home/index.php [L]
</IfModule>